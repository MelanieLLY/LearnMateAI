{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_edited_file.py\"",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Please remember to run /chat-history-log before you exit!'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); if echo \"$INPUT\" | grep -q 'git commit'; then PY=python3; for c in server/.venv/bin/python server/venv/bin/python .venv/bin/python venv/bin/python; do if [ -x \"$c\" ]; then PY=\"$PWD/$c\"; break; fi; done; echo \"[TDD GATE] Running backend tests before commit: cd server && $PY -m pytest -q\" >&2; if (cd server && \"$PY\" -m pytest -q) >&2; then exit 0; else echo '[TDD GATE] Tests failed or pytest is not installed. Commit blocked.' >&2; exit 2; fi; else exit 0; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_test_gate.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm ci)",
      "Bash(npm audit *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(node --test *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(python -m src.evals.run *)",
      "Bash(.venv/bin/python -m src.evals.run *)",
      "Bash(python seed_mock_data.py)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(pip install -r requirements.txt)",
      "Bash(pip install -r requirements-dev.txt)",
      "Bash(uvicorn src.main:app *)",
      "Edit(server/src/**)",
      "Edit(server/tests/**)",
      "Edit(CLAUDE.md)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(node_modules/**)",
      "Edit(.git/**)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git reset --hard *)",
      "Bash(git reset * --hard)",
      "Bash(git reset * --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git filter-branch *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(rm -Rf *)",
      "Bash(rm --recursive *)",
      "Bash(rm * -rf)",
      "Bash(rm * -rf *)",
      "Bash(rm * -r)",
      "Bash(rm * -r *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(render *)",
      "Bash(npx render *)",
      "Bash(curl *api.render.com*)",
      "Bash(curl *api.vercel.com*)",
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(pg_restore *)",
      "Bash(*postgres://*)",
      "Bash(*postgresql://*)",
      "Bash(*dpg-*.render.com*)",
      "Bash(*DATABASE_URL=*)"
    ]
  }
}
